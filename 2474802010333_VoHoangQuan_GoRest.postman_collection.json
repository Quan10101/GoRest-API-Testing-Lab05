      "name": "Positive_Cases",
      "item": [
        {
          "name": "01_POST_User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "\r",
                  "const row = pm.iterationData;\r",
                  "\r",
                  "const name = row.get(\"name\") || \"Nguyen Van An\";\r",
                  "const gender = row.get(\"gender\") || \"male\";\r",
                  "const email = row.get(\"email\") || \"nguyenvanan.lab05@example.com\";\r",
                  "const status = row.get(\"status\") || \"active\";\r",
                  "\r",
                  "const uniqueEmail = email.replace(\r",
                  "    \"@\",\r",
                  "    \".\" + Date.now() + \".\" + pm.info.iteration + \"@\"\r",
                  ");\r",
                  "\r",
                  "pm.variables.set(\"name\", name);\r",
                  "pm.variables.set(\"gender\", gender);\r",
                  "pm.variables.set(\"status\", status);\r",
                  "pm.variables.set(\"uniqueEmail\", uniqueEmail);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"POST User - Status 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.environment.set(\"userId\", data.id);\r",
                  "    pm.environment.set(\"createdEmail\", data.email);\r",
                  "\r",
                  "    pm.test(\"User co ID\", function () {\r",
                  "        pm.expect(data.id).to.exist;\r",
                  "    });\r",
                  "}\r",
                  "pm.execution.setNextRequest(\"06_POST_Duplicate_Email\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{uniqueEmail}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
