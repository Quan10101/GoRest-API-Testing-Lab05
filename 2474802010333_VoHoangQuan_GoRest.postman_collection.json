                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.test(\"Kiem tra User ID\", function () {\r",
                  "        pm.expect(String(data.id)).to.eql(\r",
                  "            String(pm.environment.get(\"userId\"))\r",
                  "        );\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Kiem tra Email\", function () {\r",
                  "        pm.expect(data.email).to.eql(\r",
                  "            pm.environment.get(\"createdEmail\")\r",
                  "        );\r",
                  "    });\r",
                  "}\r",
                  ""
                ],
